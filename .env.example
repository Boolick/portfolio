# ==============================================================================
# Aliaksandr Bullo — Portfolio & Engineering Blueprint
# Environment Variables Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Site URL & Canonical Host
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://resumeportfoliocv.netlify.app

# ------------------------------------------------------------------------------
# Supabase Configuration (Optional Dynamic CMS / Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# Telegram Bot & Mini App Configuration (Phase 5 - D-01)
# ------------------------------------------------------------------------------
# Public bot API token obtained from @BotFather (/newbot)
# Powers HMAC initData verification, webhook processing, and bot replies
TELEGRAM_BOT_TOKEN=

# Optional dedicated private alert bot token for owner notifications.
# If omitted or left blank, notifications automatically fall back to TELEGRAM_BOT_TOKEN
TELEGRAM_ALERT_BOT_TOKEN=

# Numeric Telegram Chat ID of the recipient owner for conversion alerts & leads
TELEGRAM_CHAT_ID=

# 32-byte secret token for Telegram webhook validation (X-Telegram-Bot-Api-Secret-Token)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# Public bot username (without @ symbol) used in client-side deep links
NEXT_PUBLIC_TG_BOT_USERNAME=bullo_dev_bot

# Mini App short name configured in @BotFather (/newapp)
NEXT_PUBLIC_TG_APP_SHORTNAME=app
